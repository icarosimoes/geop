# Observabilidade local (GlitchTip, SDK compatível com Sentry).
#
# Este é um template versionado. Para usar:
#   cp docker-compose.observability.yml.example docker-compose.observability.yml
#   docker compose -f docker-compose.yml -f docker-compose.observability.yml --profile observability up -d
#
# O arquivo resultante (docker-compose.observability.yml, sem ".example") fica de fora
# do git — ver docs/infra/observability-local.md. Escopo: apenas desenvolvimento local,
# nunca aplicado à VPS de produção (docker-stack.yml não referencia nada disto).
name: registro

services:
  glitchtip-postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_DB: glitchtip
      POSTGRES_USER: glitchtip
      POSTGRES_PASSWORD: glitchtip
    volumes:
      - registro-glitchtip-postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U glitchtip"]
      interval: 5s
      timeout: 5s
      retries: 20
    profiles:
      - observability

  glitchtip-redis:
    image: redis:7-alpine
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10
    profiles:
      - observability

  glitchtip-migrate:
    image: glitchtip/glitchtip:latest
    command: ["./manage.py", "migrate"]
    environment: &glitchtip-env
      DATABASE_URL: postgres://glitchtip:glitchtip@glitchtip-postgres:5432/glitchtip
      SECRET_KEY: ${GLITCHTIP_SECRET_KEY:-registro-local-glitchtip-secret-change-me}
      PORT: "8000"
      EMAIL_URL: consolemail://
      GLITCHTIP_DOMAIN: http://localhost:8080
      DEFAULT_FROM_EMAIL: glitchtip@registro.local
      ENABLE_OPEN_USER_REGISTRATION: "true"
      CELERY_WORKER_AUTOSCALE: "1,3"
    depends_on:
      glitchtip-postgres:
        condition: service_healthy
    profiles:
      - observability

  glitchtip-web:
    image: glitchtip/glitchtip:latest
    environment: *glitchtip-env
    ports:
      - "8080:8000"
    depends_on:
      glitchtip-postgres:
        condition: service_healthy
      glitchtip-redis:
        condition: service_healthy
      glitchtip-migrate:
        condition: service_completed_successfully
    profiles:
      - observability

  glitchtip-worker:
    image: glitchtip/glitchtip:latest
    command: ["./bin/run-celery-with-beat.sh"]
    environment: *glitchtip-env
    depends_on:
      glitchtip-postgres:
        condition: service_healthy
      glitchtip-redis:
        condition: service_healthy
      glitchtip-migrate:
        condition: service_completed_successfully
    profiles:
      - observability

volumes:
  registro-glitchtip-postgres-data:
