# PostgreSQL local descartável (porta do host: 5433)
POSTGRES_DB=registro
POSTGRES_USER=registro
POSTGRES_PASSWORD=registro
DATABASE_URL=postgresql+asyncpg://registro:registro@postgres:5432/registro

# MySQL legado (apenas para import V1 — docker compose --profile mysql-import up)
MYSQL_DATABASE=registro
MYSQL_USER=registro
MYSQL_PASSWORD=registro
MYSQL_ROOT_PASSWORD=registro-root

JWT_SECRET=change-me-with-at-least-32-random-characters
SEED_DEFAULT_PASSWORD=Registro@123
PLATFORM_ADMIN_PASSWORD=RegistroAdmin@123
CHESS_HOTEL_INTEGRATION_KEY=change-me
CHESS_HOTEL_COMPANY_SLUG=aero-hotel
REGISTRO_WEB_URL=http://localhost:3000

# OAuth2 do Google (email_client — sincronização de contas Gmail via IMAP).
# Deixe em branco pra manter desativado (contas continuam funcionando por
# usuário+senha). Passo a passo: docs/integracoes/gmail-oauth-setup.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/email-client/oauth/callback

# Observabilidade local (GlitchTip) — ver docs/infra/observability-local.md
# Deixe em branco para manter desativado. Preencha com o DSN do projeto criado no GlitchTip.
# "_INTERNAL" usa host.docker.internal (resolve de dentro dos containers).
# "_PUBLIC" usa localhost (embutido no bundle client-side, executado no browser do host).
GLITCHTIP_SECRET_KEY=registro-local-glitchtip-secret-change-me
SENTRY_DSN_API=
SENTRY_DSN_WEB_INTERNAL=
SENTRY_DSN_WEB_PUBLIC=
